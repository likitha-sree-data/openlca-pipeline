# Drape environment variables. Copy to .env for local use.
# On Hugging Face, add the server-only values as Space secrets, never as public variables.

# --- General
ENVIRONMENT=development            # development, test or production. Production disables dev sign-in and API docs.
PUBLIC_BASE_URL=http://localhost:7860   # used in reminder emails
LOG_LEVEL=INFO

# --- Database (server only). Supabase: Project settings > Database > Connection string (URI, session pooler).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/drape

# --- Supabase
SUPABASE_URL=                      # https://<project>.supabase.co. Sent to the browser for magic-link sign-in.
SUPABASE_ANON_KEY=                 # public anon key. Sent to the browser. RLS blocks it from every table.
SUPABASE_SERVICE_ROLE_KEY=         # server only. Used for Storage and for deleting auth users.
SUPABASE_JWT_SECRET=               # server only. Legacy HS256 JWT secret. Leave empty if your project uses JWT signing keys (JWKS).
SUPABASE_JWT_AUDIENCE=authenticated

# --- Drape sessions and signed local URLs (server only). Use a long random string in production.
APP_SECRET=change-me-to-64-random-characters
AUTH_DEV_LOGIN=false               # true only for local, CI and e2e. Ignored in production.
ADMIN_EMAILS=                      # comma separated emails that get the study admin page

# --- Storage
STORAGE_DRIVER=local               # local or supabase. Use supabase in production.
LOCAL_STORAGE_DIR=./.data/storage
SIGNED_URL_TTL=3600
STORAGE_QUOTA_MB=300
UPLOAD_MAX_MB=12

# --- AI provider for chat and care labels. none works at zero cost.
LLM_PROVIDER=none                  # anthropic, gemini or none
LLM_MODEL=                         # for example claude-sonnet-5-5 or gemini-2.5-flash
ANTHROPIC_API_KEY=                 # server only
GEMINI_API_KEY=                    # server only
CHAT_DAILY_CAP=50
CHAT_PER_MINUTE=10

# --- Models (all optional, each has a fallback)
ENABLE_REMBG=true
ENABLE_FASHION_CLIP=true
ENABLE_SEGFORMER=true

# --- Email (optional). Without it reminders appear in the in-app notification center.
RESEND_API_KEY=
EMAIL_FROM=Drape <reminders@yourdomain.example>

# --- Modes
STUDY_MODE=false
DEMO_MODE=false
FEATURE_COLOR_PROFILE=false

# --- Scheduled jobs. GitHub Actions sends this in the X-Cron-Secret header.
INTERNAL_CRON_SECRET=change-me-too
