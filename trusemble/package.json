{
  "name": "trusemble",
  "version": "0.1.0",
  "private": true,
  "description": "TruSemble: a sourced record of US wildfire mitigation (public app) and the operations app that maintains it.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/seed.ts --reset",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/create-user.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:e2e": "node scripts/e2e.cjs",
    "refresh": "tsx --env-file-if-exists=.env.local scripts/refresh.ts",
    "summary": "tsx --env-file-if-exists=.env.local scripts/weekly-summary.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "5.24.1",
    "next": "^15.5.29",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
