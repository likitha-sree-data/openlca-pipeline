# Where the data lives.
# Deployment: a hosted Postgres connection string (Neon, Supabase, Render, AWS RDS, any Postgres 13+). Add ?sslmode=require if the host asks for it.
# DATABASE_URL=postgres://user:password@host:5432/trusemble?sslmode=require
# Local work: leave DATABASE_URL empty. An embedded Postgres keeps data in ./data/pglite (one process at a time).
# ALLOW_EMBEDDED_DB=1   # only needed to run the embedded database with NODE_ENV=production
# DATABASE_POOL_MAX=5   # connections per server instance; keep low on serverless hosts
# Required in production: a long random string used to sign operator sessions
SESSION_SECRET=change-me-to-a-long-random-string
# Password given to seeded operators by `npm run db:seed` (dev only)
SEED_PASSWORD=trusemble-dev
# Public site: show rows labelled "demo" (true for local development and demos only)
PUBLIC_INCLUDE_DEMO=true
# Public site base URL (used in sitemap and links)
SITE_URL=http://localhost:3000
# Contact address shown in the public footer
CONTACT_EMAIL=hello@example.org
# Optional: self-hosted or alternative MapLibre style URL (default is OpenFreeMap)
# NEXT_PUBLIC_MAP_STYLE=https://tiles.example.org/styles/positron
